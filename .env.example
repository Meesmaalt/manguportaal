# Avalik alamtee (build + runtime peavad klappima)
# docker-compose.yml build.args.VITE_BASE_PATH peab olema sama + "/"
BASE_PATH=/mangud

# PocketBase URL, mida BRAUSER kasutab.
# Variant A (lihtne, töötab alati kui port 8090 on avatud):
PB_PUBLIC_URL=https://tools.thormen.com:8090
# või
# PB_PUBLIC_URL=http://192.168.x.x:8090

# Variant B (kui nginx proksib /mangud/pb -> pocketbase:8090):
# PB_PUBLIC_URL=/mangud/pb
