# Alamtee reverse proxy taga (nt https://domain.ee/mangud/)
# Jäta tühjaks kui rakendus on juurtes
BASE_PATH=/mangud

# PocketBase brauseri URL
# Variant A – otse PB portile:
# PB_PUBLIC_URL=http://192.168.88.28:8090
# Variant B – sama proxy all (nginx /mangud/pb -> pocketbase:8090):
PB_PUBLIC_URL=/mangud/pb
