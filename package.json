{
  "name": "ohtu-mangud-root",
  "version": "3.36.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build:rules && npm run build --workspace=frontend && mkdir -p dist && cp -r frontend/dist/* dist/",
    "start": "NODE_ENV=production node --experimental-strip-types server.ts",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend",
    "pb:sync": "node scripts/sync-pb-schema.cjs",
    "test": "node --test tests/*.test.mjs",
    "test:browser": "node tests/browser-smoke.mjs",
    "build:rules": "node scripts/build-card-rules.mjs",
    "test:server": "npm run build:rules && node tests/uno-flex-server.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.0"
  },
  "devDependencies": {
    "playwright": "^1.62.1",
    "esbuild": "^0.25.12"
  }
}
