{
  "name": "ohtu-mangud-root",
  "version": "3.31.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev --workspace=frontend",
    "build": "npm run build --workspace=frontend && mkdir -p dist && cp -r frontend/dist/* dist/",
    "start": "NODE_ENV=production node --experimental-strip-types server.ts",
    "preview": "npm run preview --workspace=frontend",
    "lint": "npm run lint --workspace=frontend"
  },
  "dependencies": {
    "@google/genai": "^2.22.0",
    "express": "^5.2.1",
    "http-proxy-middleware": "^3.0.0"
  }
}
